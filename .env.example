NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — Supabase Auth (see lib/supabaseAdmin.ts). NEVER prefix
# with NEXT_PUBLIC_, never commit a real value, never send it to the
# browser. Used only for Admin-only account-linking operations that the
# anon key cannot perform at all. Get it from Supabase dashboard ->
# Project Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL this app is served from — used to build Supabase Auth email
# links (password reset, etc.) so they redirect back here instead of
# localhost in production. Falls back to http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=

# Gemini (server-side only). Used for OCR (reading handwritten note text
# off a photo) and the AI end-of-day summary. There is no department-based
# image classification/blocking in this app (removed by design — any
# relevant construction/site photo is accepted); this key never gates
# whether an image upload succeeds. PRODUCTION: use a key from a Google AI
# Studio / Google Cloud project with BILLING ENABLED (paid tier). A
# free-tier key has small per-model daily/per-minute quotas; when they run
# out, OCR extraction (not the photo upload itself) fails closed and
# retries later. Never commit a real key.
GEMINI_API_KEY=
# Model used for OCR/summary (default: gemini-3.6-flash).
# GEMINI_VISION_MODEL=gemini-3.6-flash
ASSEMBLYAI_API_KEY=

# Backup providers — interfaces reserved in lib/ocr.ts and lib/stt.ts,
# not called yet. Uncomment/set when a real fallback is wired in.
AZURE_DOCUMENT_INTELLIGENCE_KEY=
DEEPGRAM_API_KEY=
GOOGLE_STT_API_KEY=

# Optional model overrides (defaults are set in lib/ocr.ts)
# GEMINI_VISION_MODEL=gemini-3.6-flash
