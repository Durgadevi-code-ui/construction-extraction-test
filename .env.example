NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — Supabase Auth (see lib/supabaseAdmin.ts). NEVER prefix
# with NEXT_PUBLIC_, never commit a real value, never send it to the
# browser. Used only for Admin-only account-linking operations that the
# anon key cannot perform at all. Get it from Supabase dashboard ->
# Project Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL this app is served from — used to build Supabase Auth email
# links (password reset, etc.) so they redirect back here instead of
# localhost in production. Falls back to http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=

GEMINI_API_KEY=
ASSEMBLYAI_API_KEY=

# Backup providers — interfaces reserved in lib/ocr.ts and lib/stt.ts,
# not called yet. Uncomment/set when a real fallback is wired in.
AZURE_DOCUMENT_INTELLIGENCE_KEY=
DEEPGRAM_API_KEY=
GOOGLE_STT_API_KEY=

# Optional model overrides (defaults are set in lib/ocr.ts)
# GEMINI_VISION_MODEL=gemini-3.6-flash

# Demo login mode (see lib/demoAuth.ts) — OFF unless explicitly set to
# "true". Never enable in production. Each DEMO_USER_*_EMAIL must be
# the email of an EXISTING, already-linked (auth_user_id set) test
# account — demo mode selects among real accounts, it never creates
# one, and never touches that account's password/email/role/department.
# A button only appears on /login when both DEMO_MODE=true and that
# slot's email is set — one slot per real role+department test account.
DEMO_MODE=false
DEMO_USER_ADMIN_EMAIL=
DEMO_USER_SUPERVISOR_CONCRETE_EMAIL=
DEMO_USER_SUPERVISOR_ELECTRICAL_EMAIL=
DEMO_USER_SUPERVISOR_PLUMBING_EMAIL=
DEMO_USER_FOREMAN_CONCRETE_EMAIL=
DEMO_USER_FOREMAN_ELECTRICAL_EMAIL=
DEMO_USER_FOREMAN_PLUMBING_EMAIL=
DEMO_USER_WORKER_ELECTRICAL_EMAIL=
DEMO_USER_WORKER_PLUMBING_EMAIL=
DEMO_USER_WORKER_HVAC_EMAIL=
DEMO_USER_WORKER_CONCRETE_EMAIL=
